{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/localyhost/EasyInstall-Templates/main/schema/template.schema.json",
  "title": "MC Easy Install Template",
  "description": "Describes how a Minecraft plugin is set up via \"Easy Install\".",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "match", "meta", "steps"],
  "properties": {
    "schema": { "const": 1, "description": "Version of the template format. Always 1." },
    "match": { "$ref": "#/$defs/match" },
    "meta": { "$ref": "#/$defs/meta" },
    "requirements": { "$ref": "#/$defs/requirements" },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
    "bundle": { "type": "array", "items": { "$ref": "#/$defs/bundleEntry" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "uninstall": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
    "on_error": {
      "enum": ["rollback", "stop", "continue"],
      "default": "rollback",
      "description": "What happens when a step fails."
    },
    "test": {
      "description": "Only for the automated install test in this repo; panels ignore this block.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "object",
          "description": "Test values for options (override default). Never real secrets!"
        },
        "software": { "$ref": "#/$defs/software", "description": "Server software for the test (default: paper)." },
        "skip": { "type": "string", "minLength": 1, "description": "Reason why the install test is skipped." }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "errorMessage": "lowercase letters, digits and _ only, starting with a letter"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "errorMessage": "lowercase letters, digits and - only"
    },
    "software": {
      "enum": ["paper", "purpur", "spigot", "folia", "velocity", "bungeecord", "waterfall", "fabric", "forge", "neoforge", "quilt"]
    },
    "softwareList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/software" } },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$",
      "errorMessage": "path must be relative to the server folder (no leading /, no ..)"
    },
    "timeout": {
      "type": "string",
      "pattern": "^[0-9]+(s|m)$",
      "errorMessage": "number followed by s or m, e.g. 90s or 5m"
    },
    "modrinthMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{8}$",
          "errorMessage": "Modrinth project ID: exactly 8 characters (A-Z, a-z, 0-9), not the slug"
        },
        "loaders": { "$ref": "#/$defs/softwareList" }
      }
    },
    "spigotMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id"],
      "properties": {
        "resource_id": { "type": "integer", "minimum": 1 }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["modrinth"] }, { "required": ["spigot"] }],
      "properties": {
        "modrinth": { "$ref": "#/$defs/modrinthMatch" },
        "spigot": { "$ref": "#/$defs/spigotMatch" },
        "prefer": { "enum": ["modrinth", "spigot"] }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maintainer", "tested_with"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maintainer": { "type": "string", "minLength": 1 },
        "tested_with": { "type": "string", "minLength": 1 },
        "updated": { "type": "string", "format": "date", "errorMessage": "date in the format YYYY-MM-DD" },
        "notes": { "type": "string" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "software": { "$ref": "#/$defs/softwareList" },
        "mc": { "type": "string", "minLength": 1 },
        "java": { "type": "string", "minLength": 1 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "collapsed": { "type": "boolean" },
        "advanced": { "type": "boolean" }
      }
    },

    "condition": {
      "description": "Fixed condition: exactly field + one operator, or all/any/not.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*|server\\.(software|mc_version|memory|ip|port)|bundle\\.[a-z0-9][a-z0-9-]*)$",
          "errorMessage": "option key, server.(software|mc_version|memory|ip|port) or bundle.<id>"
        },
        "is": { "type": ["string", "number", "boolean"] },
        "in": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } },
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "lte": { "type": "number" },
        "not_empty": { "const": true },
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" }
      },
      "dependentRequired": {
        "is": ["field"], "in": ["field"], "gt": ["field"], "gte": ["field"],
        "lt": ["field"], "lte": ["field"], "not_empty": ["field"]
      },
      "if": { "required": ["field"] },
      "then": {
        "minProperties": 2,
        "maxProperties": 2,
        "properties": { "all": false, "any": false, "not": false }
      },
      "else": { "maxProperties": 1 }
    },

    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "choices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/choice" } },
    "scalar": { "type": ["string", "number", "boolean"] },

    "optionBase": {
      "description": "Fields shared by all form fields.",
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "$ref": "#/$defs/key" },
        "required": { "type": "boolean" },
        "advanced": { "type": "boolean" },
        "show_when": { "$ref": "#/$defs/condition" },
        "enable_when": { "$ref": "#/$defs/condition" },
        "disabled_hint": { "type": "string" }
      },
      "required": ["key", "type", "label"]
    },
    "option": {
      "type": "object",
      "required": ["type"],
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        { "$ref": "#/$defs/opt_switch" },
        { "$ref": "#/$defs/opt_slider" },
        { "$ref": "#/$defs/opt_number" },
        { "$ref": "#/$defs/opt_text" },
        { "$ref": "#/$defs/opt_textarea" },
        { "$ref": "#/$defs/opt_secret" },
        { "$ref": "#/$defs/opt_select" },
        { "$ref": "#/$defs/opt_radio" },
        { "$ref": "#/$defs/opt_multiselect" },
        { "$ref": "#/$defs/opt_list" },
        { "$ref": "#/$defs/opt_allocation" },
        { "$ref": "#/$defs/opt_world" },
        { "$ref": "#/$defs/opt_info" }
      ]
    },
    "opt_switch": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "properties": {
        "type": { "const": "switch" },
        "default": { "type": "boolean" }
      },
      "unevaluatedProperties": false
    },
    "opt_slider": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "required": ["min", "max"],
      "properties": {
        "type": { "const": "slider" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string" },
        "default": { "type": "number" }
      },
      "unevaluatedProperties": false
    },
    "opt_number": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "properties": {
        "type": { "const": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string" },
        "default": { "type": "number" }
      },
      "unevaluatedProperties": false
    },
    "opt_text": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "properties": {
        "type": { "const": "text" },
        "placeholder": { "type": "string" },
        "min_length": { "type": "integer", "minimum": 0 },
        "max_length": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "preview": { "const": "mc-color" },
        "default": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "opt_textarea": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "properties": {
        "type": { "const": "textarea" },
        "rows": { "type": "integer", "minimum": 1 },
        "max_length": { "type": "integer", "minimum": 1 },
        "preview": { "const": "mc-color" },
        "default": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "opt_secret": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "properties": {
        "type": { "const": "secret" },
        "generate": { "type": "boolean" },
        "min_length": { "type": "integer", "minimum": 0 },
        "default": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "opt_select": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "required": ["options"],
      "properties": {
        "type": { "const": "select" },
        "options": { "$ref": "#/$defs/choices" },
        "default": { "$ref": "#/$defs/scalar" }
      },
      "unevaluatedProperties": false
    },
    "opt_radio": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "required": ["options"],
      "properties": {
        "type": { "const": "radio" },
        "options": { "$ref": "#/$defs/choices" },
        "default": { "$ref": "#/$defs/scalar" }
      },
      "unevaluatedProperties": false
    },
    "opt_multiselect": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "required": ["options"],
      "properties": {
        "type": { "const": "multiselect" },
        "options": { "$ref": "#/$defs/choices" },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "default": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/scalar" } }
      },
      "unevaluatedProperties": false
    },
    "opt_list": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "properties": {
        "type": { "const": "list" },
        "item_type": { "enum": ["string", "number"], "default": "string" },
        "max_items": { "type": "integer", "minimum": 1 },
        "default": { "type": "array", "items": { "type": ["string", "number"] } }
      },
      "unevaluatedProperties": false
    },
    "opt_allocation": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "required": ["protocol", "mode"],
      "properties": {
        "type": { "const": "allocation" },
        "protocol": { "enum": ["tcp", "udp", "both"] },
        "mode": { "enum": ["select", "create", "select_or_create"] },
        "prefer_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "exclude_primary": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "label_on_create": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    },
    "opt_world": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/optionBase" }],
      "properties": {
        "type": { "const": "world" },
        "allow_multiple": { "type": "boolean" },
        "default": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "opt_info": {
      "type": "object",
      "required": ["key", "type", "label", "style"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "const": "info" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "$ref": "#/$defs/key" },
        "advanced": { "type": "boolean" },
        "show_when": { "$ref": "#/$defs/condition" },
        "style": { "enum": ["info", "warning"] }
      }
    },

    "bundleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match"],
      "properties": {
        "id": { "$ref": "#/$defs/bundleId" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modrinth": { "$ref": "#/$defs/modrinthMatch" },
            "spigot": { "$ref": "#/$defs/spigotMatch" },
            "prefer": { "enum": ["modrinth", "spigot"] }
          },
          "anyOf": [{ "required": ["modrinth"] }, { "required": ["spigot"] }]
        },
        "when": { "$ref": "#/$defs/condition" }
      }
    },

    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "replace"],
      "properties": {
        "when": { "$ref": "#/$defs/condition" },
        "replace": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "stepBase": {
      "properties": {
        "action": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/$defs/condition" }
      },
      "required": ["action"]
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "discriminator": { "propertyName": "action" },
      "oneOf": [
        { "$ref": "#/$defs/step_install" },
        { "$ref": "#/$defs/step_first_start" },
        { "$ref": "#/$defs/step_config" },
        { "$ref": "#/$defs/step_file" },
        { "$ref": "#/$defs/step_allocate" },
        { "$ref": "#/$defs/step_release" },
        { "$ref": "#/$defs/step_command" },
        { "$ref": "#/$defs/step_restart" },
        { "$ref": "#/$defs/step_reload" },
        { "$ref": "#/$defs/step_wait" },
        { "$ref": "#/$defs/step_verify" },
        { "$ref": "#/$defs/step_delete" },
        { "$ref": "#/$defs/step_script" }
      ]
    },
    "step_install": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["target"],
      "properties": {
        "action": { "const": "install" },
        "target": { "$ref": "#/$defs/bundleId", "description": "main, bundle or a bundle ID" }
      },
      "unevaluatedProperties": false
    },
    "step_first_start": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["wait_for"],
      "properties": {
        "action": { "const": "first_start" },
        "wait_for": { "$ref": "#/$defs/relPath" },
        "timeout": { "$ref": "#/$defs/timeout" }
      },
      "unevaluatedProperties": false
    },
    "step_config": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["file", "values"],
      "properties": {
        "action": { "const": "config" },
        "file": { "$ref": "#/$defs/relPath" },
        "format": { "enum": ["yaml", "json", "properties", "toml", "hocon", "env"] },
        "mode": { "enum": ["merge", "replace", "create_if_missing"], "default": "merge" },
        "values": { "type": "object", "minProperties": 1 }
      },
      "unevaluatedProperties": false
    },
    "step_file": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["from", "to"],
      "properties": {
        "action": { "const": "file" },
        "from": { "$ref": "#/$defs/relPath" },
        "to": { "$ref": "#/$defs/relPath" },
        "overwrite": { "type": "boolean" }
      },
      "unevaluatedProperties": false
    },
    "step_allocate": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["option"],
      "properties": {
        "action": { "const": "allocate" },
        "option": { "$ref": "#/$defs/key" }
      },
      "unevaluatedProperties": false
    },
    "step_release": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["option"],
      "properties": {
        "action": { "const": "release" },
        "option": { "$ref": "#/$defs/key" }
      },
      "unevaluatedProperties": false
    },
    "step_command": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["command"],
      "properties": {
        "action": { "const": "command" },
        "command": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    },
    "step_restart": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "properties": { "action": { "const": "restart" } },
      "unevaluatedProperties": false
    },
    "step_reload": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "properties": {
        "action": { "const": "reload" },
        "command": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    },
    "waitFields": {
      "properties": {
        "log_contains": { "type": "string", "minLength": 1 },
        "file_exists": { "$ref": "#/$defs/relPath" },
        "timeout": { "$ref": "#/$defs/timeout" }
      },
      "anyOf": [{ "required": ["log_contains"] }, { "required": ["file_exists"] }]
    },
    "step_wait": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }, { "$ref": "#/$defs/waitFields" }],
      "properties": { "action": { "const": "wait" } },
      "unevaluatedProperties": false
    },
    "step_verify": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }, { "$ref": "#/$defs/waitFields" }],
      "properties": { "action": { "const": "verify" } },
      "unevaluatedProperties": false
    },
    "step_delete": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["paths"],
      "properties": {
        "action": { "const": "delete" },
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relPath" } },
        "ask": { "type": "boolean" }
      },
      "unevaluatedProperties": false
    },
    "step_script": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["runtime", "code"],
      "properties": {
        "action": { "const": "script" },
        "runtime": { "enum": ["js", "lua"] },
        "code": { "type": "string", "minLength": 1 },
        "timeout": { "$ref": "#/$defs/timeout" }
      },
      "unevaluatedProperties": false
    }
  }
}
